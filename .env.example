# ==============================================================================
# Codit (TCC-Codit) — Contrato de Variáveis de Ambiente
# ==============================================================================
# NUNCA commite arquivos `.env` ou `.env.local` reais no Git.
# Variáveis `NEXT_PUBLIC_*` entram no bundle estático (`out/`): use apenas
# valores públicos seguros (como URL e ANON KEY do Supabase com RLS ativo).
# NUNCA adicione o prefixo `NEXT_PUBLIC_` em segredos ou chaves de API privadas.

# URL canônica da aplicação (callbacks OAuth, links absolutos e metadados)
APP_BASE_URL="http://localhost:3000"

# Fase 2 — Supabase Client-Side (Web/PWA, Tauri .exe e Capacitor .apk)
# A chave ANON é pública por design e depende das políticas RLS no PostgreSQL.
# NUNCA coloque `SUPABASE_SERVICE_ROLE_KEY` em variáveis `NEXT_PUBLIC_*`.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Opcional na dev local; RECOMENDADO em produção Web/Tauri para apontar confirmação
# de e-mail e Google OAuth à URL pública canônica (ex.: https://codit.app/auth/callback)
# NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT_URL="https://codit.app/auth/callback"
# Opcional: sobrescreve o retorno OAuth e confirmação no app Android
# Padrão: https://codit-omega.vercel.app/auth/native-callback (ponte para com.codit.app://auth/callback)
# Use com.codit.app://auth/callback direto apenas se a URL estiver liberada em Redirect URLs no Supabase
# NEXT_PUBLIC_SUPABASE_NATIVE_REDIRECT_URL=""

# Fase 2 — Banco de Dados PostgreSQL (pendente DEC-001 / DEC-004)
# DATABASE_URL="postgresql://codit:codit@localhost:5432/codit_dev?schema=public"

# Fase 2 — Autenticação e Sessão (pendente DEC-003)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Fase 2 — Google OAuth 2.0 / OIDC
# URI de callback esperado: ${APP_BASE_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Fase 4 — Tutor IA Octopy (pendente DEC-002)
AI_PROVIDER="gemini"
AI_PROVIDER_API_KEY=""
# Provedor secundário opcional de contingência (fallback)
# AI_FALLBACK_PROVIDER=""
# AI_FALLBACK_API_KEY=""

# Fase 2+ — Sandbox Remoto Multi-Linguagem (Judge0 CE / Piston)
# SANDBOX_API_URL="https://ce.judge0.com"
# SANDBOX_API_KEY=""

# Sistema de Mensagens & Chamadas de Voz/Tela (WebRTC ICE/STUN/TURN)
# Opcional: sobrescreve os servidores STUN padrão (Google e Cloudflare) com servidores
# STUN/TURN próprios em JSON válido para redes corporativas / NAT simétrico restrito.
# Exemplo: NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON='[{"urls":["stun:stun.l.google.com:19302"]}]'
# NEXT_PUBLIC_WEBRTC_ICE_SERVERS_JSON=""
