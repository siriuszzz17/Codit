{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Codit",
  "version": "0.1.0",
  "identifier": "com.codit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codit",
        "width": 1280,
        "height": 800,
        "minWidth": 375,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZCOThEOUJFQUU3Q0ZBNkUKUldSdStueXV2dG1ZYXo2eEl5K21OQ1Vmb3JtSG1Sa3R4bGRlaWlJRTExOUtMb3FvMDdBbzlOdG4K",
      "endpoints": [
        "https://github.com/siriuszzz17/Codit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
